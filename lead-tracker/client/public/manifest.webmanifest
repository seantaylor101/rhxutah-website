{
  "name": "Lead Hammer",
  "short_name": "Lead Hammer",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#32473D",
  "theme_color": "#32473D",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "contact", "accept": ["text/vcard", "text/x-vcard", ".vcf"] }
      ]
    }
  }
}
