PORT=4000
NODE_ENV=development

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Postgres ---
# DATABASE_URL: the DB owner connection, used only by scripts/setup-db-roles.js and
# src/db/migrate.js (schema/role management). Not used by the running app.
DATABASE_URL=postgresql://user:password@host:5432/leadhammer

# APP_DATABASE_URL / PLATFORM_DATABASE_URL: the two roles the running app actually
# connects as. Create them once per environment with:
#   APP_DB_PASSWORD=... PLATFORM_DB_PASSWORD=... DATABASE_URL=... npm run setup-db-roles
#   DATABASE_URL=... npm run migrate
# leadhammer_app is tenant-scoped by Row-Level Security (every tenant_admin/pm session
# uses it). leadhammer_platform is used only for platform_admin sessions and has no
# grant at all on any business table -- see src/db/migrations/0002_rls.sql.
APP_DATABASE_URL=postgresql://leadhammer_app:replace-with-app-db-password@host:5432/leadhammer
PLATFORM_DATABASE_URL=postgresql://leadhammer_platform:replace-with-platform-db-password@host:5432/leadhammer

# Local file storage for warranty photo uploads (multer disk storage). The Docker image
# should point this at a mounted persistent volume, same idea as the old DB_PATH did.
UPLOADS_DIR=./data/uploads

# --- Public website lead intake (routes/public.js) ---
# One deployment currently serves one public marketing site, so a single shared secret
# plus a single target tenant id is enough -- see routes/public.js for the limitation.
FORM_INTAKE_KEY=replace-with-a-random-string
PUBLIC_INTAKE_TENANT_ID=replace-with-the-onboarded-tenant-id

# The same Web3Forms access key already used by the site's own contact/quote
# forms (visible in their HTML). Reused here so the server can send a backup
# email on every new website lead, landing wherever those forms already go.
WEB3FORMS_ACCESS_KEY=

# Web Push (VAPID) keys for push notifications. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Public key is safe to expose to the browser; keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Used in the backup-email link ("Open Lead Hammer: ..."). Defaults to the old
# single-tenant Render URL if unset.
APP_URL=
