PORT=4000

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# The one true administrator account, created automatically on first boot if
# no admin exists yet (safe to leave these set permanently — the bootstrap is
# skipped once an admin account already exists). Everyone else signs in with
# an account the admin creates in Settings > Manage team — there's no public
# sign-up.
ADMIN_EMAIL=replace-with-your-email
ADMIN_PASSWORD=replace-with-a-strong-password

# Where the SQLite database file lives. The Docker image sets this to /app/data/leads.db
# and expects that path to be a mounted volume so data survives redeploys.
DB_PATH=./data/leads.db

# Shared secret the public website's forms send along with each lead submission
# (header X-Intake-Key) so /api/public/leads isn't wide open to anyone who finds
# the URL. Not a high-security secret — it's embedded in the site's public HTML,
# same trust model as the Web3Forms access key below — just a basic filter.
FORM_INTAKE_KEY=replace-with-a-random-string

# The same Web3Forms access key already used by the site's own contact/quote
# forms (visible in their HTML). Reused here so the server can send a backup
# email on every new website lead, landing wherever those forms already go.
WEB3FORMS_ACCESS_KEY=

# Web Push (VAPID) keys for push notifications. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Public key is safe to expose to the browser; keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
