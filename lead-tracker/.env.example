PORT=4000

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Two shared passcodes — anyone who knows OWNER_PASSCODE can add/edit/delete leads,
# anyone who knows VIEWER_PASSCODE can only look. Pick two different values.
OWNER_PASSCODE=replace-with-a-secret-editor-passcode
VIEWER_PASSCODE=replace-with-a-secret-viewer-passcode

# Where the SQLite database file lives. The Docker image sets this to /app/data/leads.db
# and expects that path to be a mounted volume so data survives redeploys.
DB_PATH=./data/leads.db
